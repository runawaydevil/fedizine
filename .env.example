# App
APP_NAME=Fedizine
APP_ENV=development
APP_PORT=8000
HOST_PORT=4927
APP_PUBLIC_URL=http://localhost:4927
APP_SECRET_KEY=change-me-to-random-64-chars
TRUST_PROXY=true

# Locale
DEFAULT_LOCALE=en_US
DEFAULT_TIMEZONE=UTC

# Database
POSTGRES_DB=fedizine
POSTGRES_USER=fedizine
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://fedizine:change-me@postgres:5432/fedizine

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Storage
STORAGE_PATH=/data/storage
PUBLIC_PATH=/data/public
MEDIA_PATH=/data/media
MAX_MEDIA_SIZE_MB=10

# Default user (seed via: fedizine create-user)
DEFAULT_USER_EMAIL=editor@example.com
DEFAULT_USER_NAME=Demo Editor
DEFAULT_USER_SLUG=demo

# Auth
ENABLE_PUBLIC_SIGNUP=false
SESSION_MAX_AGE=86400

# Editorial
EDITORIAL_SCORE_THRESHOLD=50
COLLECTION_INTERVAL_HOURS=24
COLLECT_TIMEOUT_SECONDS=30

# AI (disabled MVP)
ENABLE_AI_ASSISTANT=false
AI_PROVIDER=none
OPENAI_API_KEY=

# Security
ALLOWED_URL_SCHEMES=https
BLOCK_PRIVATE_IPS=true
